{
  "openapi": "3.1.0",
  "info": {
    "title": "Trellis API",
    "version": "0.1.0",
    "description": "Stateless, self-hostable API. Request body limit 5 MiB. No authentication is included; place behind your own gateway for public service."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Server available"
          }
        }
      }
    },
    "/v1/plan": {
      "post": {
        "summary": "See what is holding everything up.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tasks"
                ],
                "properties": {
                  "tasks": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50000,
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "duration",
                        "dependsOn"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "duration": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1000000000.0
                        },
                        "dependsOn": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Analysis result. Trellis includes feasible:false and a cycle witness for cyclic graphs."
          },
          "400": {
            "description": "Invalid input"
          },
          "413": {
            "description": "Request exceeds 5 MiB"
          }
        }
      }
    }
  }
}